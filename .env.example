# ─────────────────────────────  Auth.js / NextAuth  ──────────────────────────
# Clave para cifrar la cookie de sesión. Genera una con:  npx auth secret
AUTH_SECRET=

# Credenciales del cliente OAuth de Google (Google Cloud Console → APIs y
# servicios → Credenciales → ID de cliente de OAuth 2.0, tipo "Aplicación web").
# Orígenes autorizados de JavaScript:  http://localhost:3000
# URI de redireccionamiento autorizados: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=xxxxxxxxxxxx.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=GOCSPX-xxxxxxxxxxxxxxxx

# En Vercel no hace falta: la URL se detecta sola. Descomenta solo si despliegas
# detrás de un proxy y el login redirige a un host equivocado.
# AUTH_URL=https://front-agent-pr.vercel.app
# AUTH_TRUST_HOST=true

# ───────────────────────────────────  Backend  ────────────────────────────────
# Servicio webhookAgentPR. Sin barra final.
BACKEND_URL=https://webhook-agent-pr.vercel.app
